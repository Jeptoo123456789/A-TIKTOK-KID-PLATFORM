# ==============================================================================
# KinVid Platform Environment Configuration
# Safe Short-Video Social Platform for Children & Families
# ==============================================================================

# Application Port (AI Studio / Production requires 3000)
PORT=3000
NODE_ENV=development

# Server Host
HOST=0.0.0.0

# Base Application URL
APP_URL=http://localhost:3000

# Security: JWT Token Secret for session signatures
JWT_SECRET=kinvid_dev_secure_session_secret_change_in_production_2026

# Database Configuration
# Supported drivers: "local" (ACID WAL persistent engine) or "postgres" (via DATABASE_URL)
DATABASE_DRIVER=local
DATABASE_PATH=./data/kinvid.db.json
# DATABASE_URL=postgresql://user:password@localhost:5432/kinvid_db

# Storage Driver for Video Files and Thumbnails
# Options: "local" (secure private storage in ./uploads) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_ALLOWED_FORMATS=video/mp4,video/webm,video/quicktime

# Moderation & Child Safety Controls
DEFAULT_DAILY_SCREEN_TIME_MINUTES=60
DEFAULT_CURFEW_START=20:00
DEFAULT_CURFEW_END=07:00
AUTO_SCREENING_ENABLED=true

# AI Capabilities (Injected by AI Studio)
GEMINI_API_KEY=MY_GEMINI_API_KEY
